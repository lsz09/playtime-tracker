<Window x:Class="PlayTimeTracker.App.ManageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PlayTimeTracker - 프로그램 관리" Width="980" Height="620" MinWidth="840" MinHeight="360"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20,16,20,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,14">
            <TextBlock x:Name="HeadingText" Text="프로그램 관리" FontSize="22" FontWeight="SemiBold" />
            <TextBlock x:Name="IntroText" Opacity="0.6" Margin="0,2,0,0" TextWrapping="Wrap" />
            <TextBlock x:Name="TagsText" Opacity="0.6" Margin="0,6,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,14,4" Opacity="0.6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="170" />
                <ColumnDefinition Width="190" />
                <ColumnDefinition x:Name="AlertHeaderColumn" Width="110" />
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="100" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="프로그램" FontSize="12" />
            <TextBlock Grid.Column="1" Text="표시 이름" FontSize="12" Margin="8,0,0,0" />
            <TextBlock Grid.Column="2" Text="묶음 태그 (쉼표로 여러 개)" FontSize="12" Margin="8,0,0,0" />
            <TextBlock Grid.Column="3" Text="알림 (시간마다)" FontSize="12" Margin="8,0,0,0" TextTrimming="CharacterEllipsis" />
        </Grid>

        <Grid Grid.Row="2">
            <TextBlock x:Name="EmptyText" Opacity="0.6" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="Collapsed" />
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="ProgramList" Margin="0,0,14,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="190" />
                                    <ColumnDefinition Width="{Binding AlertColumnWidth}" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="100" />
                                </Grid.ColumnDefinitions>
                                <Image Source="{Binding Icon}" Width="24" Height="24"
                                       HorizontalAlignment="Left" VerticalAlignment="Center"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                <StackPanel Margin="34,0,8,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DefaultName}" FontSize="14" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding ExePath}" />
                                    <TextBlock Text="{Binding ExeName}" FontSize="11" Opacity="0.6"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBox Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center"
                                         Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBox Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center"
                                         Text="{Binding GroupName, UpdateSourceTrigger=PropertyChanged}" />
                                <!-- 몇 시간마다 알릴지 (비우면 알림 없음) -->
                                <TextBox Grid.Column="3" Margin="8,0,0,0" VerticalAlignment="Center"
                                         Visibility="{Binding AlertVisibility}"
                                         ToolTip="이 프로그램이 이만큼 실행될 때마다 알립니다. 예: 1 = 1시간마다, 0.5 = 30분마다. 비우면 알림 없음."
                                         Text="{Binding AlertText, UpdateSourceTrigger=PropertyChanged}" />
                                <!-- 프로그램 관리에서는 "게임", 게임 관리에서는 "게임 해제" -->
                                <Button Grid.Column="4" Content="{Binding MoveText}" Margin="8,0,0,0" Padding="10,5"
                                        HorizontalAlignment="Stretch" VerticalAlignment="Center" Click="OnMoveClick" />
                                <!-- 목록과 DB에서 완전히 삭제 + 감지 제외 -->
                                <Button Grid.Column="5" Content="{Binding ActionText}" Margin="8,0,0,0" Padding="10,5"
                                        HorizontalAlignment="Stretch" VerticalAlignment="Center" Click="OnDeleteOrRestoreClick" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <CheckBox x:Name="ShowHiddenOption" Content="제외한 프로그램도 보기" VerticalAlignment="Center"
                      HorizontalAlignment="Left" Checked="OnShowHiddenChanged" Unchecked="OnShowHiddenChanged" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="제외 목록" Padding="16,6" Margin="0,0,8,0" Click="OnExclusionsClick" />
                <Button x:Name="GameManageButton" Content="게임관리" Padding="16,6" Margin="0,0,8,0"
                        Click="OnGameManageClick" />
                <Button Content="저장" Padding="22,6" Click="OnSaveClick" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
