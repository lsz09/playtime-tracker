<Window x:Class="PlayTimeTracker.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PlayTimeTracker - 설정" Width="520" Height="680"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20,16,20,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="설정" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,16" />

        <StackPanel Grid.Row="1">
            <TextBlock Text="화면 크기" FontSize="14" FontWeight="SemiBold" />
            <TextBlock Opacity="0.6" Margin="0,2,0,8" TextWrapping="Wrap"
                       Text="여기서 고른 배율로 모든 창의 글자와 기본 크기가 한꺼번에 커지거나 작아집니다. 바꾸면 바로 적용됩니다. 각 창은 테두리를 마우스로 끌어 따로 늘리거나 줄일 수도 있습니다." />
            <ComboBox x:Name="ScaleBox" HorizontalAlignment="Left" Width="260" SelectionChanged="OnScaleChanged" />
            <TextBlock x:Name="ScaleInfoText" Opacity="0.6" Margin="0,8,0,0" TextWrapping="Wrap" />

            <TextBlock Text="배경" FontSize="14" FontWeight="SemiBold" Margin="0,22,0,0" />
            <ComboBox x:Name="ThemeBox" HorizontalAlignment="Left" Width="260" Margin="0,6,0,0" SelectionChanged="OnThemeChanged">
                <ComboBoxItem Content="윈도우 설정 따름" Tag="system" />
                <ComboBoxItem Content="화이트 모드" Tag="light" />
                <ComboBoxItem Content="블랙 모드" Tag="dark" />
            </ComboBox>

            <TextBlock Text="작은 창" FontSize="14" FontWeight="SemiBold" Margin="0,22,0,0" />
            <CheckBox x:Name="MiniOption" Margin="0,6,0,0" Checked="OnMiniChanged" Unchecked="OnMiniChanged"
                      Content="메인 창을 닫으면 작은 창 띄우기" />
            <TextBlock Opacity="0.6" Margin="0,4,0,0" TextWrapping="Wrap"
                       Text="작은 창은 항상 위에 떠서 지금 포커스된 프로그램의 이름과 오늘 사용 시간을 보여 줍니다. 끌어서 옮길 수 있고, 두 번 누르면 메인 창이 다시 열립니다. 크기는 오른쪽 아래 모서리를 끌거나 마우스 휠로 바꿉니다." />

            <TextBlock Text="알림" FontSize="14" FontWeight="SemiBold" Margin="0,22,0,0" />
            <TextBlock Opacity="0.6" Margin="0,2,0,8" TextWrapping="Wrap"
                       Text="사용 시간 알림은 화면 오른쪽 아래에 팝업으로 뜹니다. 간격은 프로그램 관리와 게임 관리의 알림 칸에서 정합니다." />
            <Button Content="알림 테스트" HorizontalAlignment="Left" Padding="16,6" Click="OnTestAlertClick" />
        </StackPanel>

        <Button Grid.Row="2" Content="닫기" HorizontalAlignment="Right" Padding="22,6" Click="OnCloseClick" />
    </Grid>
</Window>
