<Window x:Class="PlayTimeTracker.App.DetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PlayTimeTracker - 상세" Width="900" Height="660" MinWidth="720" MinHeight="420"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20,16,20,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 이름 -->
        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Image x:Name="IconImage" Width="36" Height="36" Margin="0,0,12,0" VerticalAlignment="Center"
                   RenderOptions.BitmapScalingMode="HighQuality" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="NameText" FontSize="22" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="DetailText" Opacity="0.6" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <Button Grid.Column="2" Content="새로고침" Padding="14,6" VerticalAlignment="Center" Click="OnRefreshClick" />
        </Grid>

        <!-- 합계 -->
        <ItemsControl x:Name="SummaryList" Grid.Row="1" Margin="0,0,0,16">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,0,8,0" Padding="14,10" CornerRadius="8" Background="{StaticResource TrackBrush}">
                        <StackPanel>
                            <TextBlock Text="{Binding Label}" FontSize="12" Opacity="0.7" />
                            <TextBlock Text="{Binding RunText}" FontSize="20" FontWeight="SemiBold" Margin="0,2,0,0"
                                       Typography.NumeralAlignment="Tabular" />
                            <TextBlock Text="{Binding FocusText}" FontSize="11" Opacity="0.6"
                                       Typography.NumeralAlignment="Tabular" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 날짜별 -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="날짜별 사용 시간 (최근 30일)" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8" />
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="DayList" Margin="0,0,14,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="92" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="72" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding DateText}" FontSize="13" VerticalAlignment="Center"
                                               Opacity="{Binding TextOpacity}" />
                                    <Grid Grid.Column="1" Height="14" VerticalAlignment="Center">
                                        <Border Background="{StaticResource TrackBrush}" />
                                        <Border Background="{StaticResource AccentSoftBrush}">
                                            <Border.RenderTransform>
                                                <ScaleTransform ScaleX="{Binding RunRatio}" />
                                            </Border.RenderTransform>
                                        </Border>
                                        <Border Background="{StaticResource AccentBrush}">
                                            <Border.RenderTransform>
                                                <ScaleTransform ScaleX="{Binding FocusRatio}" />
                                            </Border.RenderTransform>
                                        </Border>
                                    </Grid>
                                    <TextBlock Grid.Column="2" Text="{Binding RunText}" FontSize="13"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"
                                               Opacity="{Binding TextOpacity}" ToolTip="{Binding Tip}"
                                               Typography.NumeralAlignment="Tabular" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- 사용 기록 -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="SessionHeading" Text="사용 기록" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8" />
                <TextBlock x:Name="EmptyText" Grid.Row="1" Text="기록이 없습니다." Opacity="0.6"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="SessionList" Margin="0,0,14,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="72" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding WhenText}" FontSize="13" TextTrimming="CharacterEllipsis"
                                                   Typography.NumeralAlignment="Tabular" />
                                        <TextBlock Text="{Binding SubText}" FontSize="11" Opacity="0.6"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding RunText}" FontSize="13"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"
                                               Typography.NumeralAlignment="Tabular" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>

        <TextBlock x:Name="FooterText" Grid.Row="3" Margin="0,12,0,0" Opacity="0.75" TextWrapping="Wrap" />
    </Grid>
</Window>
