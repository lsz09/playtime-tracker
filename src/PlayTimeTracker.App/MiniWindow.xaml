<Window x:Class="PlayTimeTracker.App.MiniWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PlayTimeTracker - 작은 창"
        WindowStyle="None" ResizeMode="NoResize" SizeToContent="WidthAndHeight"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        MouseLeftButtonDown="OnDrag" MouseDoubleClick="OnDoubleClick" MouseWheel="OnWheel"
        ToolTip="끌어서 옮기기 · 두 번 눌러 메인 창 열기 · 휠이나 오른쪽 아래 모서리로 크기 조절">
    <Border BorderBrush="{StaticResource AccentBrush}" BorderThickness="1">
      <Grid>
        <Grid.Resources>
            <ControlTemplate x:Key="EdgeTemplate" TargetType="Thumb">
                <Border Background="Transparent" />
            </ControlTemplate>
        </Grid.Resources>
        <StackPanel Orientation="Horizontal" Margin="12,8">
            <Image x:Name="IconImage" Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center"
                   RenderOptions.BitmapScalingMode="HighQuality" />
            <TextBlock x:Name="NameText" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"
                       MaxWidth="260" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="TimeTextBlock" FontSize="14" VerticalAlignment="Center" Margin="6,0,0,0"
                       Typography.NumeralAlignment="Tabular" />
            <Button Content="✕" FontSize="10" Padding="6,2" Margin="12,0,0,0" VerticalAlignment="Center"
                    ToolTip="작은 창 닫기 (기록은 계속됩니다)" Click="OnCloseClick" />
        </StackPanel>

        <!-- 크기 조절: 네 변과 오른쪽 아래 모서리를 끈다 (내용 위에 얹는다) -->
        <Thumb Tag="W" HorizontalAlignment="Left" Width="5" Cursor="SizeWE" Template="{StaticResource EdgeTemplate}"
               DragStarted="OnResizeStarted" DragDelta="OnResizeDelta" DragCompleted="OnResizeCompleted" />
        <Thumb Tag="E" HorizontalAlignment="Right" Width="5" Cursor="SizeWE" Template="{StaticResource EdgeTemplate}"
               DragStarted="OnResizeStarted" DragDelta="OnResizeDelta" DragCompleted="OnResizeCompleted" />
        <Thumb Tag="N" VerticalAlignment="Top" Height="5" Cursor="SizeNS" Template="{StaticResource EdgeTemplate}"
               DragStarted="OnResizeStarted" DragDelta="OnResizeDelta" DragCompleted="OnResizeCompleted" />
        <Thumb Tag="S" VerticalAlignment="Bottom" Height="5" Cursor="SizeNS" Template="{StaticResource EdgeTemplate}"
               DragStarted="OnResizeStarted" DragDelta="OnResizeDelta" DragCompleted="OnResizeCompleted" />
        <Thumb Tag="SE" HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="14" Height="14" Cursor="SizeNWSE"
               ToolTip="끌어서 크기 조절"
               DragStarted="OnResizeStarted" DragDelta="OnResizeDelta" DragCompleted="OnResizeCompleted">
            <Thumb.Template>
                <ControlTemplate TargetType="Thumb">
                    <Grid Background="Transparent">
                        <Path Data="M 12,4 L 12,12 L 4,12 Z" Fill="{StaticResource AccentBrush}" />
                    </Grid>
                </ControlTemplate>
            </Thumb.Template>
        </Thumb>
      </Grid>
    </Border>
</Window>
