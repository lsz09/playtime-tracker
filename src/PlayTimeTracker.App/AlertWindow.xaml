<Window x:Class="PlayTimeTracker.App.AlertWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PlayTimeTracker - 알림"
        WindowStyle="None" ResizeMode="NoResize" SizeToContent="WidthAndHeight"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False">
    <Border BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" Padding="16,12,16,14" Width="340">
        <StackPanel>
            <Grid>
                <TextBlock x:Name="TitleText" FontSize="13" FontWeight="SemiBold"
                           Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                <Button Content="✕" FontSize="10" Padding="6,2" HorizontalAlignment="Right"
                        ToolTip="닫기" Click="OnCloseClick" />
            </Grid>
            <TextBlock x:Name="MessageText" FontSize="15" TextWrapping="Wrap" Margin="0,8,0,0" />
            <TextBlock x:Name="TimeText" FontSize="12" Opacity="0.6" Margin="0,6,0,0" />
        </StackPanel>
    </Border>
</Window>
