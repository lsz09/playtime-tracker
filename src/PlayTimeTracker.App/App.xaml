<Application x:Class="PlayTimeTracker.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ThemeMode="System"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#4F7CFF" />
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#594F7CFF" />
        <SolidColorBrush x:Key="AccentRowBrush" Color="#224F7CFF" />
        <SolidColorBrush x:Key="TrackBrush" Color="#22808080" />
    </Application.Resources>
</Application>
